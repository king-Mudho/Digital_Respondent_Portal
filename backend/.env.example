DJANGO_SETTINGS_MODULE=config.settings.prod
DJANGO_SECRET_KEY=changeme
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=research.agribizframework.com

DATABASE_URL=postgres://drp_user:changeme@localhost:5432/drp_db

JWT_SIGNING_KEY=changeme
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=30
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

INVITATION_TOKEN_BYTES=32
INVITATION_TOKEN_EXPIRY_DAYS=14

KOBO_API_BASE_URL=https://kf.kobotoolbox.org
KOBO_API_TOKEN=changeme
KOBO_ASSET_UID=changeme
# Public web-form link from the project's Collect data page (ee. host), not the asset UID
KOBO_FORM_URL=https://ee.kobotoolbox.org/x/changeme
KOBO_WEBHOOK_SHARED_SECRET=changeme
KOBO_RECONCILIATION_INTERVAL_MINUTES=15
# KII Guide and Document Analysis Tool assets (PDF copies and the PI's data exports)
KOBO_KII_ASSET_UID=
KOBO_DOCUMENTS_ASSET_UID=
# Document, Digital Platform & Media Analysis Tool's public web-form link (ee. host, like KOBO_FORM_URL) --
# powers the "Code this document" button that prefills the DOC-ID and known fields
KOBO_DOCUMENTS_FORM_URL=
# Main Study KII Guide's public web-form link (ee. host, like KOBO_FORM_URL) --
# powers the "Continue this interview" button; only offered once participation consent is GIVEN
KOBO_KII_FORM_URL=

# Full Kobo payloads live here, never under a web-served folder
PRIVATE_DATA_ROOT=/srv/agribiz-drp/backend/private_data
# Uploaded documentary-evidence source files also live under PRIVATE_DATA_ROOT
DOCUMENT_MAX_UPLOAD_MB=20

# AI-assisted document coding draft (apps/evidence/ai_coding.py) -- only ever produces
# a draft; a human reviews it in the portal before anything reaches KoboToolbox
ANTHROPIC_API_KEY=
AI_DOCUMENT_CODING_MODEL=claude-opus-5

# OpenRosa submission endpoint the reviewed draft is submitted to (apps/evidence/kobo_submit.py) --
# a different host from KOBO_API_BASE_URL; KOBO_ACCOUNT_USERNAME is the Kobo account's own username
KOBO_OPENROSA_BASE_URL=https://kc.kobotoolbox.org
KOBO_ACCOUNT_USERNAME=

PROIT_ENABLED_FOR_RESPONDENTS=True

# Outgoing mail (completed-form PDFs); set by deploy/configure-email.sh
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=abffst.research@gmail.com
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=ABF-FST Research <abffst.research@gmail.com>
STUDY_REPLY_TO_EMAIL=abffst.research@gmail.com

WHATSAPP_API_BASE_URL=changeme
WHATSAPP_API_TOKEN=changeme
WHATSAPP_BUSINESS_ACCOUNT_ID=changeme

CELERY_BROKER_URL=redis://localhost:6379/0

CORS_ALLOWED_ORIGINS=https://research.agribizframework.com
CSRF_TRUSTED_ORIGINS=https://research.agribizframework.com

BACKUP_RPO_HOURS=4
BACKUP_RTO_HOURS=4
