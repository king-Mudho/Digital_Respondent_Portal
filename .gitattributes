# Force LF line endings for everything text-based, regardless of the
# checking-out machine's core.autocrlf setting. Deployment shell scripts
# and systemd units are extracted directly onto a Linux server via `git
# archive` -- a CRLF-mangled shebang line (`#!/usr/bin/env bash\r`) fails
# to execute at all, which is exactly what happened during Phase 10
# deployment before this file existed.
* text=auto eol=lf

*.sh text eol=lf
*.service text eol=lf
*.conf text eol=lf
*.py text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.json text eol=lf
*.md text eol=lf

*.docx binary
